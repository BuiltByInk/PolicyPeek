---
// Free, unlimited checks are the catalog's growth loop (see CLAUDE.md's
// "Business Model & ICP") -- this is the only place on the actual website
// a visitor can use that loop; before this, it only existed via the raw
// API and the browser extension. Posts straight to the backend's
// POST /v1/check from the client, no server round-trip of our own since
// this is a static site.
const apiBase = import.meta.env.PUBLIC_API_BASE_URL as string | undefined;
---
<div class="submit-panel" id="submit">
  <h2 class="lp-head">Don't see a tool?</h2>
  <p class="intro">
    Give us its website and a link to its privacy policy. It's free — one check every 24 hours.
    The check runs automatically, and the result is either published straight away or held for a
    person to look at first.
  </p>
  <form id="submit-form" data-api-base={apiBase ?? ""} novalidate>
    <label>
      <span>Website</span>
      <input type="text" name="domain" id="f-domain" placeholder="example.com" required
        inputmode="url" autocapitalize="off" autocorrect="off" autocomplete="off" spellcheck="false"
        aria-describedby="submit-hint submit-status" />
    </label>
    <label>
      <span>Link to their privacy policy</span>
      <input type="text" name="source_url" id="f-source" placeholder="example.com/privacy" required
        inputmode="url" autocapitalize="off" autocorrect="off" autocomplete="off" spellcheck="false"
        aria-describedby="submit-hint submit-status" />
    </label>
    <button type="submit">Check this tool</button>
  </form>
  <p id="submit-hint" class="hint">You can paste full links. We'll use just the site name and the policy page.</p>
  <p id="submit-status" role="status" aria-live="polite"></p>
</div>

<style>
  .submit-panel {
    margin: 1.75rem 0 2.25rem;
    border: 3px solid var(--line);
  }
  .lp-head {
    margin: 0;
    line-height: 1.3;
    padding: 0.6rem 1rem;
    border-bottom: 3px solid var(--line);
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .intro {
    margin: 0;
    padding: 1rem 1rem 0.25rem;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 0.88rem;
    max-width: 60ch;
  }
  form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
    align-items: end;
    padding: 0.75rem 1rem 1.1rem;
  }
  label { display: flex; flex-direction: column; gap: 0.3rem; font-family: var(--font-body); }
  label span {
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  input {
    font: inherit;
    font-family: var(--font-mono);
    font-size: 1rem; /* 16px: keeps iOS Safari from zooming the page on focus */
    padding: 0.6rem 0.6rem;
    min-height: 2.75rem;
    border: 1.5px solid var(--line);
    border-radius: 0;
    background: var(--bg);
    color: var(--fg);
  }
  button {
    font: inherit;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.6rem 1rem;
    background: var(--fg);
    color: var(--bg);
    border: 2px solid var(--fg);
    cursor: pointer;
    height: fit-content;
    min-height: 2.75rem;
    border-radius: 0;
  }
  button:disabled { opacity: 0.6; cursor: default; }
  /* Same invert-on-hover treatment as the homepage .cta button -- these two
     already share the exact same fg/bg/border colors, just had no hover
     state defined here. */
  button:hover:not(:disabled) {
    background: var(--bg);
    color: var(--fg);
  }
  .hint {
    margin: 0;
    padding: 0 1rem 0.6rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  #submit-status {
    margin: 0;
    padding: 0 1rem 1rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    min-height: 1.2em;
    overflow-wrap: anywhere;
  }
  input[aria-invalid="true"] { border-color: var(--red-fg); border-width: 3px; padding: calc(0.5rem - 1.5px) calc(0.6rem - 1.5px); }
  #submit-status[data-tone="error"] { color: var(--red-fg); }
  #submit-status[data-tone="error"]::before { content: "Problem: "; }
  #submit-status[data-tone="ok"] { color: var(--green-fg); }
  #submit-status[data-tone="ok"]::before { content: "Done: "; }
</style>

<script>
  import { VERDICTS } from "../verdicts";

  const form = document.getElementById("submit-form") as HTMLFormElement | null;
  const status = document.getElementById("submit-status");
  if (form && status) {
    const apiBase = form.dataset.apiBase;
    const domainInput = form.elements.namedItem("domain") as HTMLInputElement;
    const sourceInput = form.elements.namedItem("source_url") as HTMLInputElement;
    const button = form.querySelector("button") as HTMLButtonElement;

    // Mirrors the API's own isValidDomain() so a typo is caught here, with a
    // specific message, instead of coming back as a generic 400.
    const DOMAIN_RE = /^[a-z0-9.-]+\.[a-z]{2,}$/;

    function show(tone: "ok" | "error" | "", msg: string, field?: HTMLInputElement) {
      status!.dataset.tone = tone;
      status!.textContent = msg; // textContent only: nothing typed or returned is ever parsed as HTML
      domainInput.removeAttribute("aria-invalid");
      sourceInput.removeAttribute("aria-invalid");
      if (tone === "error" && field) {
        field.setAttribute("aria-invalid", "true");
        field.focus();
      }
    }

    // Accepts "example.com", "www.example.com", "https://www.Example.com/some/page?x=1".
    // Returns just the bare hostname the API expects (no scheme, path, port or leading www.).
    function cleanDomain(raw: string): string {
      let t = raw.trim().toLowerCase();
      t = t.replace(/^[a-z][a-z0-9+.-]*:\/\//, ""); // scheme
      t = t.replace(/^[^@/]*@/, "");                   // user:pass@
      t = t.split(/[/?#]/)[0];                         // path / query / fragment
      t = t.replace(/:\d+$/, "");                      // port
      t = t.replace(/^www\./, "");
      return t.replace(/\.$/, "");
    }
    // Accepts "example.com/privacy" as well as a full URL; returns a full https URL or "".
    function cleanSource(raw: string): string {
      const t = raw.trim();
      if (!t) return "";
      const withScheme = /^[a-z][a-z0-9+.-]*:\/\//i.test(t) ? t : "https://" + t;
      try {
        const u = new URL(withScheme);
        return u.protocol === "https:" || u.protocol === "http:" ? u.href : "";
      } catch { return ""; }
    }

    function resetTime(iso: unknown): string {
      if (typeof iso !== "string") return "";
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return "";
      return d.toLocaleString(undefined, { weekday: "short", hour: "numeric", minute: "2-digit" });
    }

    // After a new submission is accepted, ask the public lookup (the same one
    // the extension uses) whether it has published yet. A clean result
    // publishes within seconds; anything else waits for a person and has no
    // set time, so after about a minute we say that plainly instead of
    // promising a time. matched_domain must equal what was submitted: lookup
    // also matches parent domains, and a parent's verdict isn't this tool's.
    async function waitForVerdict(domain: string) {
      const POLL_MS = 3_000;
      const POLL_TRIES = 20;
      show("", `Got it. Checking ${domain} now. Clear results are published within about a minute.`);
      for (let i = 0; i < POLL_TRIES; i++) {
        await new Promise((r) => setTimeout(r, POLL_MS));
        try {
          const res = await fetch(`${apiBase}/v1/lookup?domain=${encodeURIComponent(domain)}`);
          if (res.ok) {
            const data: any = await res.json().catch(() => null);
            const verdict = VERDICTS.find((v) => v.status === data?.compliance_status);
            if (verdict && data?.matched_domain === domain) {
              show("ok", `${domain} is published: ${verdict.label}. ${verdict.meaning} The browser extension shows it now; the list on this site updates the next time the site is refreshed.`);
              return;
            }
          }
        } catch { /* a failed poll is just tried again */ }
      }
      show("ok", `We haven't published a verdict for ${domain} yet. Clear results appear within a minute; anything else is checked by a person first, and there's no set time for that. The browser extension shows the verdict as soon as it's published. The list on this site updates the next time the site is refreshed.`);
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const domain = cleanDomain(domainInput.value);
      const sourceUrl = cleanSource(sourceInput.value);

      if (!domainInput.value.trim()) return show("error", "Enter the tool's website, for example example.com.", domainInput);
      if (!DOMAIN_RE.test(domain)) return show("error", "That doesn't look like a website name. Enter it like example.com.", domainInput);
      if (!sourceInput.value.trim()) return show("error", "Paste a link to the tool's privacy policy.", sourceInput);
      if (!sourceUrl) return show("error", "That doesn't look like a link. Paste the address of the privacy policy page.", sourceInput);
      let sourceHost = "";
      try { sourceHost = new URL(sourceUrl).hostname.toLowerCase(); } catch { /* checked above */ }
      if (sourceHost !== domain && !sourceHost.endsWith("." + domain)) {
        return show("error", `The policy link has to be on ${domain} (or one of its subpages). This one is on ${sourceHost}.`, sourceInput);
      }
      // Show the cleaned-up values so what we send is what they see.
      domainInput.value = domain;
      sourceInput.value = sourceUrl;

      if (!apiBase) return show("error", "Submissions aren't switched on yet. Check back soon.");

      button.disabled = true;
      button.textContent = "Checking…";
      status.setAttribute("aria-busy", "true");
      show("", "Checking the policy page. This can take up to a minute.");

      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 60_000);
      try {
        const res = await fetch(`${apiBase}/v1/check`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ domain, source_url: sourceUrl }),
          signal: ctrl.signal,
        });
        // A gateway error can come back as HTML; don't let that masquerade as "couldn't reach".
        const body: any = await res.json().catch(() => ({}));
        const err = typeof body?.error === "string" ? body.error : "";

        if (res.status === 202) {
          form.reset();
          if (body.is_recheck) {
            show("ok", `${domain} is already in the catalog. We're re-checking it now. The list on this site updates the next time the site is refreshed.`);
          } else {
            await waitForVerdict(domain);
          }
        } else if (err === "daily_capacity_reached") {
          // The service-wide daily ceiling, not this person's own limit.
          show("error", "We've reached the number of checks we can run today. Nothing you did wrong, and your own daily check is unused. Please try again tomorrow.");
        } else if (res.status === 429 || err === "daily_check_limit_reached") {
          const when = resetTime(body?.resets_at);
          show("error", when
            ? `You've used your free check for today. You can check another tool after ${when}.`
            : "You've used your free check for today. You can check another tool in 24 hours.");
        } else if (err === "invalid_domain") {
          show("error", "That doesn't look like a website name. Enter it like example.com.", domainInput);
        } else if (err === "source_url_domain_mismatch") {
          show("error", `The policy link has to be on ${domain} (or one of its subpages).`, sourceInput);
        } else if (err === "missing_source_url" || err === "invalid_source_url") {
          show("error", "That doesn't look like a link. Paste the address of the privacy policy page.", sourceInput);
        } else if (err === "blocked_url") {
          show("error", "We can't open that link. Use the public address of the privacy policy page.", sourceInput);
        } else if (res.status === 502 || err === "fetch_failed") {
          show("error", "We couldn't open that policy page. Check the link works in your browser. Some sites also block automated checks.", sourceInput);
        } else if (res.status === 400) {
          show("error", "Something about the website or the link isn't right. Check both and try again.");
        } else {
          show("error", "Something went wrong on our side. Try again in a moment.");
        }
      } catch (e) {
        const timedOut = e instanceof DOMException && e.name === "AbortError";
        show("error", timedOut
          ? "That's taking longer than expected. Wait a minute, then try again."
          : "We couldn't reach the checking service. Check your connection and try again.");
      } finally {
        clearTimeout(timer);
        status.removeAttribute("aria-busy");
        button.disabled = false;
        button.textContent = "Check this tool";
        // A disabled button drops keyboard focus to <body>; give it back
        // unless show() already moved focus to a field with a problem.
        if (document.activeElement === document.body) button.focus();
      }
    });
  }
</script>
