---
export interface Props {
  title: string;
  description: string;
  /** Keep this page out of search results (also keep it out of the sitemap -- see astro.config.mjs). */
  noindex?: boolean;
  /** Path or absolute URL of the social-share image. Defaults to the site-wide card. */
  ogImage?: string;
  /** schema.org structured data for the page: one object or an array. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Path of a plain-Markdown copy of this page (advertised as rel="alternate" for AI agents). */
  markdownAlt?: string;
}

const { title, description, noindex = false, ogImage = "/og-image.png", jsonLd, markdownAlt } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const path = Astro.url.pathname;
// Cloudflare Web Analytics: cookieless, no personal data, and the token is a
// public site tag (it ships in page HTML), not a secret. Set
// PUBLIC_CF_BEACON_TOKEN at build time to turn it on; unset = no beacon.
const cfBeaconToken = (import.meta.env.PUBLIC_CF_BEACON_TOKEN ?? "").trim();

// Structured data is built from tools.json, which holds LLM-extracted text
// (tool names etc.), so it is untrusted. JSON.stringify alone doesn't make it
// safe inside a <script> block: a "</script>" in a string would end the block
// early. Escaping "<" (and the two JS line separators) as \uXXXX keeps the
// JSON identical for parsers but can never close the tag.
const jsonLdString = jsonLd
  ? JSON.stringify(jsonLd)
      .replace(/</g, "\\u003c")
      .replace(new RegExp("[\\u2028\\u2029]", "g"), (c) => "\\u" + c.charCodeAt(0).toString(16))
  : null;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · PolicyPeek</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {markdownAlt && <link rel="alternate" type="text/markdown" href={new URL(markdownAlt, Astro.site)} />}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PolicyPeek" />
    <meta property="og:title" content={`${title} · PolicyPeek`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PolicyPeek: Does it train on your data? Plain-English verdicts on AI tools, sourced from each tool's own privacy policy." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · PolicyPeek`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* Same-origin fonts (no third-party request). Only the two files used above the fold on every page are preloaded. */}
    <link rel="preload" href="/fonts/barlow-condensed-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />

    <style is:global>
      /* Headline face: Barlow Condensed (SIL OFL 1.1, licence in
         /fonts/OFL-BarlowCondensed.txt), self-hosted, Latin subset, 700 + 800
         only (~22 KB each). Replaces the old "Helvetica Neue Condensed / Arial
         Narrow" system-font gamble, which only condensed on Apple and
         Windows/Office. display: swap so text is never held back.
         The fallback face below is Arial Bold scaled to Barlow Condensed's
         measured average width (measured 74% over 8 mixed sample strings: 6052 vs 8137 units;
         77% chosen after checking real page heights, lowercase-heavy
         headlines run wider in Barlow than the average, see
         research/ui_audit_2026-09-18.md) with its ascent/descent divided by
         the same factor (Barlow: 1.00 / 0.20), so a slow font load changes line
         breaks and page height as little as possible when the swap happens. */
      @font-face {
        font-family: "Barlow Condensed";
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("/fonts/barlow-condensed-latin-700-normal.woff2") format("woff2");
      }
      @font-face {
        font-family: "Barlow Condensed";
        font-style: normal;
        font-weight: 800;
        font-display: swap;
        src: url("/fonts/barlow-condensed-latin-800-normal.woff2") format("woff2");
      }
      @font-face {
        font-family: "Barlow Condensed Fallback";
        font-style: normal;
        font-weight: 700 800;
        src: local("Arial Bold"), local("Arial-BoldMT"), local("Helvetica-Bold"), local("Liberation Sans Bold"), local("Arimo Bold");
        size-adjust: 77%;
        ascent-override: 130%;
        descent-override: 26%;
        line-gap-override: 0%;
      }
      /* NOTE (2026-09-18 UI audit): this block is is:global on purpose. It was
         scoped before, which meant Astro only applied h1/h2/h3, a:focus-visible
         and box-sizing to elements written in THIS file -- never to headings
         or links inside page slot content, so every page heading rendered in
         plain Arial 700 and page-level links had no custom focus ring.
         Page/component <style> blocks stay scoped. */
      /* Design direction: "Compliance Label" -- modeled on nutrition-facts /
         energy-rating panels. Black keylines instead of soft grey borders,
         a condensed headline face for the regulatory-document voice,
         tabular monospace for every number, sharp corners throughout (no
         rounded-lg default). See DECISIONS_NEEDED.md (2026-08-17 UI entry)
         for the other two directions this was picked over. */
      :root {
        color-scheme: light dark;
        --fg: #111318;
        --bg: #ffffff;
        --muted: #565b66;
        --line: #111318;
        --line-soft: #d6d8dc;
        --panel: #f7f7f5;
        --id: #1f3a5f;
        --green-bg: #e6f4ea; --green-fg: #1e7a34;
        --amber-bg: #fef3e2; --amber-fg: #92600a;
        --red-bg: #fce8e6; --red-fg: #b3261e;
        /* caveat = a genuinely separate hue (teal), not a green/amber blend --
           this is "we DO know, and it's conditional," a different epistemic
           state than amber's "we don't know." Never reuse green/amber/red
           here or it reads as a rounding of one of those states. */
        --caveat-bg: #e2eef4; --caveat-fg: #12586f;
        /* gray = not_ai_tool. Deliberately neutral, not a shade of green/
           amber/red/teal -- this isn't a compliance verdict at all, it's
           "this question doesn't apply here." Must read as clearly outside
           the compliant/caveats/not_compliant/unrated spectrum. */
        --gray-bg: #eceef0; --gray-fg: #40464f;
        --font-head: "Barlow Condensed", "Barlow Condensed Fallback", "Arial Narrow", Arial, sans-serif;
        --font-body: Arial, Helvetica, sans-serif;
        --font-mono: ui-monospace, "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --fg: #ececec;
          --bg: #14161a;
          --muted: #a3a8b3;
          --line: #d8dade;
          --line-soft: #34373f;
          --panel: #1b1e24;
          --id: #8ab4ff;
          --green-bg: #123821; --green-fg: #6fe39a;
          --amber-bg: #3a2c0d; --amber-fg: #f2c14e;
          --red-bg: #3a1414; --red-fg: #f28b82;
          --caveat-bg: #0f2e38; --caveat-fg: #7fd4ec;
          --gray-bg: #24272d; --gray-fg: #c2c6cc;
        }
      }
      :root[data-theme="dark"] {
        --fg: #ececec;
        --bg: #14161a;
        --muted: #a3a8b3;
        --line: #d8dade;
        --line-soft: #34373f;
        --panel: #1b1e24;
        --id: #8ab4ff;
        --green-bg: #123821; --green-fg: #6fe39a;
        --amber-bg: #3a2c0d; --amber-fg: #f2c14e;
        --red-bg: #3a1414; --red-fg: #f28b82;
        --caveat-bg: #0f2e38; --caveat-fg: #7fd4ec;
        --gray-bg: #24272d; --gray-fg: #c2c6cc;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--font-body);
        color: var(--fg);
        background: var(--bg);
        line-height: 1.6;
      }
      h1, h2, h3 {
        font-family: var(--font-head);
        font-weight: 800;
        letter-spacing: 0;
        line-height: 1.1;
        text-wrap: balance;
      }
      /* Barlow Condensed sets narrower than Arial at the same size; these
         defaults keep headings the visual weight they had. */
      h1 { font-size: clamp(2.4rem, 6.5vw, 3.2rem); }
      h2 { font-size: 1.7rem; }
      .wrap {
        max-width: 880px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }
      header.site {
        border-bottom: 3px solid var(--line);
      }
      header.site .wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding-top: 1rem;
        padding-bottom: 1rem;
      }
      header.site a.brand {
        font-family: var(--font-head);
        font-weight: 800;
        font-size: 1.6rem;
        letter-spacing: 0.01em;
        line-height: 1.2;
        color: var(--fg);
        text-decoration: none;
      }
      header.site a.brand::before {
        content: "■ ";
        color: var(--id);
      }
      nav.site a {
        color: var(--muted);
        text-decoration: none;
        margin-left: 1.5rem;
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }
      nav.site a { display: inline-block; padding: 0.4rem 0; }
      nav.site a:hover, nav.site a[aria-current="page"] { color: var(--fg); }
      nav.site a[aria-current="page"] { box-shadow: inset 0 -3px 0 var(--id); }
      /* Body links: navy (--id) + underline. Before this, in-page links fell
         back to the browser default (#0000ee blue / purple visited), the only
         off-palette colour on the site. Underline stays so links are not
         distinguished by colour alone (WCAG 1.4.1). */
      a { color: var(--id); text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
      a:hover { text-decoration-thickness: 2px; }
      nav.site a, header.site a.brand { text-decoration: none; }
      /* Global focus-visible for links -- SubmitTool.astro's inputs/button
         use this exact --id outline treatment; extends the convention
         site-wide. */
      a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible {
        outline: 2px solid var(--id);
        outline-offset: 2px;
      }
      /* Browser-default placeholder grey (#757575) is 3.9:1 on the dark page
         background; --muted is 6.8:1 (light) and 7.6:1 (dark). */
      ::placeholder { color: var(--muted); opacity: 1; }
      .skip {
        position: absolute; left: 0.5rem; top: -4rem;
        background: var(--fg); color: var(--bg);
        padding: 0.6rem 0.9rem; font-weight: 700; z-index: 10;
      }
      .skip:focus { top: 0.5rem; }
      .sr-only {
        position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
        overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
      }
      /* Was `main { padding: 2rem 0 3rem }`, which lost to `.wrap { padding: 0
         1.25rem }` on specificity -- computed padding-top/bottom was 0px, so
         page content butted against the header and footer rules. */
      main.wrap { padding-top: 2rem; padding-bottom: 3rem; }
      footer.site {
        border-top: 3px solid var(--line);
        color: var(--muted);
        font-size: 0.85rem;
      }
      footer.site .wrap { padding: 1.5rem 1.25rem; }
      footer.site .foot-extra { display: block; margin-top: 0.5rem; }
      @media (max-width: 480px) {
        /* Audit P4: keep logo + nav on one row on phones (wrapping pushed the hero down ~50px). */
        header.site .wrap { flex-wrap: nowrap; gap: 0.5rem; padding-top: 0.75rem; padding-bottom: 0.75rem; }
        header.site a.brand { font-size: 1.3rem; }
        nav.site { white-space: nowrap; }
        nav.site a { margin-left: 0.9rem; font-size: 0.74rem; letter-spacing: 0.04em; }
      }
      @media (max-width: 640px) {
        /* Four nav items don't fit beside the logo on phones/narrow tablets:
           put the nav on its own full-width row so every link stays reachable. */
        header.site .wrap { flex-wrap: wrap; row-gap: 0.25rem; }
        nav.site { width: 100%; display: flex; flex-wrap: wrap; gap: 0 1.1rem; white-space: normal; }
        nav.site a { margin-left: 0; }
      }
      /* Print: a checked result is something people save or print for a
         colleague/relative. Drop chrome and forms, force black-on-white, and
         show link targets so a printed source list is still usable. */
      /* Nothing on the site animates today; this keeps it that way if something
         is added later without remembering the preference. */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
      }
      @media print {
        :root { --fg: #000; --bg: #fff; --muted: #333; --line: #000; --id: #000; }
        header.site nav, footer.site, .skip, .submit-panel, form, .no-print { display: none !important; }
        header.site, footer.site { border-color: #000; }
        a { text-decoration: underline; }
        body { font-size: 11pt; }
      }
      /* Starter Pack / free checklist boxes (guides, tool pages, homepage). Global
         because the mid-article box is injected into Markdown by a rehype plugin. */
      .pack-box { border: 3px solid var(--line); border-left-width: 8px; background: var(--panel); padding: 0.9rem 1.1rem; margin: 1.75rem 0; max-width: 46rem; }
      .pack-box p { margin: 0.35rem 0 0; }
      .pack-box p:first-child { margin-top: 0; }
      .pack-box-title { font-family: var(--font-head); font-weight: 700; font-size: 1.1rem; }
      .pack-box-go { margin-top: 0.7rem !important; }
      .pack-box .btn { display: inline-block; padding: 0.5rem 0.85rem; border: 2px solid var(--fg); background: var(--fg); color: var(--bg); text-decoration: none; font-weight: 700; margin: 0 0.5rem 0.3rem 0; }
      .pack-box .btn:hover, .pack-box .btn:focus-visible { background: var(--bg); color: var(--fg); }
      .pack-box-small { font-size: 0.85rem; color: var(--muted); }
      .pack-box.compact { padding: 0.7rem 0.9rem; font-size: 0.95rem; }
      .pack-box.free { border-left-color: var(--id); }
      @media print { .pack-box { display: none; } }
    </style>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {jsonLdString && <script type="application/ld+json" set:html={jsonLdString} />}
    {cfBeaconToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}></script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">POLICYPEEK</a>
        <nav class="site" aria-label="Main">
          <a href="/tools"{...(path.startsWith("/tools") ? { "aria-current": "page" } : {})}>Tools</a>
          <a href="/guides/"{...(path.startsWith("/guides") ? { "aria-current": "page" } : {})}>Guides</a>
          <a href="/about"{...(path.startsWith("/about") ? { "aria-current": "page" } : {})}>Methodology</a>
          <a href="/policy-pack/"{...(path.startsWith("/policy-pack") ? { "aria-current": "page" } : {})}>For businesses</a>
        </nav>
      </div>
    </header>
    <main class="wrap" id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        PolicyPeek checks whether tools train on your data, from their own published policies. See <a href="/about">how it works</a> or read the <a href="/guides/">guides</a>.
        <span class="foot-extra">From the same team: <a href="/policy-pack">AI Policy Starter Pack by InkLLM</a>.</span>
        <span class="foot-extra"><a href="https://earlyhunt.com" target="_blank" rel="noopener">Featured on EarlyHunt</a></span>
      </div>
    </footer>
  </body>
</html>
