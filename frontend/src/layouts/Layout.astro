---
export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · PolicyPeek</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · PolicyPeek`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} · PolicyPeek`} />
    <meta name="twitter:description" content={description} />

    <style>
      :root {
        color-scheme: light dark;
        --fg: #1a1a1a;
        --bg: #ffffff;
        --muted: #5a5a5a;
        --border: #e2e2e2;
        --accent: #3454d1;
        --green-bg: #e6f4ea; --green-fg: #1e7a34;
        --amber-bg: #fef3e2; --amber-fg: #92600a;
        --red-bg: #fce8e6; --red-fg: #b3261e;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #ececec;
          --bg: #14161a;
          --muted: #a0a0a0;
          --border: #2c2f36;
          --accent: #8ab4ff;
          --green-bg: #123821; --green-fg: #6fe39a;
          --amber-bg: #3a2c0d; --amber-fg: #f2c14e;
          --red-bg: #3a1414; --red-fg: #f28b82;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: var(--fg);
        background: var(--bg);
        line-height: 1.55;
      }
      .wrap {
        max-width: 880px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }
      header.site {
        border-bottom: 1px solid var(--border);
      }
      header.site .wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding-top: 1rem;
        padding-bottom: 1rem;
      }
      header.site a.brand {
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--fg);
        text-decoration: none;
      }
      nav.site a {
        color: var(--muted);
        text-decoration: none;
        margin-left: 1.25rem;
        font-size: 0.95rem;
      }
      nav.site a:hover { color: var(--accent); }
      main { padding: 2rem 0 3rem; }
      footer.site {
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.85rem;
      }
      footer.site .wrap { padding: 1.5rem 1.25rem; }
      @media (max-width: 480px) {
        header.site .wrap { flex-direction: column; align-items: flex-start; }
        nav.site a { margin-left: 0; margin-right: 1rem; }
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">PolicyPeek</a>
        <nav class="site">
          <a href="/tools">Tools</a>
          <a href="/about">Methodology</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        PolicyPeek checks whether tools train on your data, from their own published policies. See <a href="/about">how it works</a>.
      </div>
    </footer>
  </body>
</html>
