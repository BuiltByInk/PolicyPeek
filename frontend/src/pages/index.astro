---
import Layout from "../layouts/Layout.astro";
import SubmitTool from "../components/SubmitTool.astro";
import Badge from "../components/Badge.astro";
import type { Tool } from "../types";
import { VERDICTS, sentence } from "../verdicts";
import { gumroadLink } from "../gumroad";
import toolsData from "../../data/tools.json";

const tools = toolsData as Tool[];
const counts = Object.fromEntries(VERDICTS.map((v) => [v.status, tools.filter((t) => t.compliance_status === v.status).length]));
// Register order (design audit P3): the three real verdicts first, good to
// bad, then the three "can't tell / doesn't apply" states.
const REGISTER_ORDER = ["compliant", "compliant_with_caveats", "not_compliant", "unrated", "shared_domain_unverified", "not_ai_tool"];
const registerRows = REGISTER_ORDER.map((s) => VERDICTS.find((v) => v.status === s)!).filter(Boolean);
// Quick picks (audit P1): only tools that are actually in the register.
const QUICK_PICKS = ["openai.com", "claude.com", "cursor.com", "otter.ai"];
const picks = QUICK_PICKS.map((d) => tools.find((t) => t.domain === d)).filter((t): t is Tool => Boolean(t));
// Sample verdict card: ChatGPT if listed, otherwise the first quick pick.
const sample = tools.find((t) => t.domain === "openai.com") ?? picks[0] ?? null;
const sampleVerdict = sample ? VERDICTS.find((v) => v.status === sample.compliance_status) : null;
const sampleWhy = sample?.summary?.trim() ? sentence(sample.summary) : null;
---
<Layout
  title="Does it train on your data?"
  description="PolicyPeek checks AI tools' own privacy policies and tells you, in one line, whether they train on your data — sourced from the policy itself, not a guess."
  jsonLd={[{
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "PolicyPeek",
    url: Astro.site!.href,
    logo: new URL("/apple-touch-icon.png", Astro.site!).href,
  }, {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "PolicyPeek",
    url: Astro.site!.href,
    description: "Plain-English verdicts on whether AI tools train on your data, sourced from each tool's own privacy policy.",
  }]}
>
  <section class="hero">
    <div class="hero-main">
    <p class="eyebrow">Free · AI tools · Sourced from the policy</p>
    <h1>Does it train on your data?</h1>
    <p class="lede">
      We read AI tools' privacy policies and give you a one-line answer, quoted from the policy itself.
    </p>
    <form class="find" action="/tools/" method="get" role="search">
      <label for="home-q">Which AI tool do you use?</label>
      <div class="find-row">
        <input id="home-q" name="q" type="search" placeholder="e.g. chatgpt, cursor, otter.ai"
          data-short-placeholder="e.g. chatgpt"
          autocomplete="off" spellcheck="false" />
        <button type="submit">Look it up</button>
      </div>
    </form>
    {picks.length > 0 && (
      <ul class="picks" aria-label="Popular tools">
        {picks.map((t) => <li><a href={`/tools/${t.domain}/`}>{t.name}</a></li>)}
      </ul>
    )}
    <p class="alt"><a href="/tools/">Browse all {tools.length} tool{tools.length === 1 ? "" : "s"}</a> · <a href="#submit">Don't see yours? Ask us to check it</a></p>
    </div>
    {sample && sampleVerdict && (
      <aside class="sample" aria-label={`Example verdict: ${sample.name}`}>
        <p class="s-k">Example: {sample.name}</p>
        <Badge status={sample.compliance_status} />
        <p class="s-m">{sampleVerdict.meaning}</p>
        {sampleWhy && (<><p class="s-why-k">Why</p><p class="s-why">{sampleWhy}</p></>)}
        <a href={`/tools/${sample.domain}/`}>See full verdict →</a>
      </aside>
    )}
  </section>
  <script>
    // Audit P4: the long placeholder is cut off on narrow phones.
    const q = document.getElementById("home-q") as HTMLInputElement | null;
    if (q && q.dataset.shortPlaceholder) {
      const long = q.placeholder, short = q.dataset.shortPlaceholder;
      const mq = window.matchMedia("(max-width: 480px)");
      const apply = () => { q.placeholder = mq.matches ? short : long; };
      apply();
      mq.addEventListener("change", apply);
    }
  </script>

  <section class="register" aria-labelledby="reg-h">
    <h2 id="reg-h">{tools.length} AI tool{tools.length === 1 ? "" : "s"} checked. Here's how they score.</h2>
    <p class="reg-def">Each badge says what the tool's own published policy says about training on your data. Green means it doesn't train on your data by default (or only if you opt in). It's not legal advice or a finding about any law.</p>
    <ul>
      {registerRows.map((v, i) => (
        <li class={`reg-row${i === 3 ? " group-start" : ""}`}>
          <a class="row-link" href={`/tools/?v=${v.status}`} aria-label={`See the ${counts[v.status]} tools with the badge ${v.label}`}>
            <span class="n">{counts[v.status]}</span>
            <span class="b"><Badge status={v.status} /></span>
            <span class="m">{v.meaning}</span>
            <span class="go" aria-hidden="true">See them →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>


  <section class="biz" aria-labelledby="biz-h">
    <h2 id="biz-h">For UK small businesses</h2>
    <p class="biz-def">PolicyPeek is free and stays free. If you run a small team, InkLLM, the people behind it, also make a few plain-English templates for using AI at work, free to download.</p>
    <ul>
      <li><strong>AI Policy Starter Pack</strong> <span class="p">Free</span><span class="d">A ready-to-edit AI use policy for your team, in Essentials or Complete.</span></li>
      <li><strong>Staff AI Training Kit</strong> <span class="p">Free</span><span class="d">Everything to run a short, practical AI session for your team.</span></li>
      <li><strong>Starter Pack + Training Kit bundle</strong> <span class="p">Free</span><span class="d">The Complete policy pack and the training kit together.</span></li>
      <li><strong>AI Incident Response One-Pager + Breach Log</strong> <span class="p">Free</span><span class="d">A one-page plan for when AI goes wrong at work, plus a breach log.</span></li>
    </ul>
    <p class="biz-go"><a class="btn" href={gumroadLink("starter", "homepage-biz")}>Download the Starter Pack free</a> <span>or <a href="/policy-pack/">see all business resources</a> · <a href="#home-q">check your AI tools</a> · <a href="https://getpolicypeek.com/">Custom policy agent: join when it opens</a></span></p>
    <p class="biz-by">by InkLLM</p>
  </section>

  <aside class="pack-box free" aria-labelledby="free-h">
    <p class="pack-box-title" id="free-h">Free: the AI-at-work checklist for small teams</p>
    <p>One page to work through with your staff: which AI tools are approved, what never goes in, training settings, and who checks the output. Free on Gumroad (or pay what you like). Enter your email and it's sent straight to you.</p>
    <p class="pack-box-go"><a class="btn" href={gumroadLink("checklist", "homepage-free")}>Get the free checklist</a></p>
  </aside>

  {/* Every tool as a plain crawlable link (SEO 2026-10-23). */}
  <section class="all-tools" aria-labelledby="all-h">
    <h2 id="all-h">Every tool we've checked</h2>
    <ul>
      {[...tools].sort((a, b) => a.name.localeCompare(b.name)).map((t) => (
        <li><a href={`/tools/${t.domain}/`}>{t.name}</a></li>
      ))}
    </ul>
  </section>

  <section class="how">
    <h2>How a rating gets made</h2>
    <ol>
      <li>An AI model extracts the facts from the tool's own published privacy policy. We don't guess.</li>
      <li>Then fixed rules, the same for every tool, decide the badge.</li>
      <li>Clear-cut results publish automatically. Anything uncertain gets a person's eyes first.</li>
    </ol>
    <p><a href="/about">Read the full methodology →</a></p>
  </section>

  <SubmitTool />
</Layout>

<style>
  .all-tools ul { list-style: none; padding: 0; margin: 0.5rem 0 2rem; display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; font-size: 0.95rem; }
  .hero { padding: 0.5rem 0 1.5rem; }
  .eyebrow {
    font-family: var(--font-head);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--id);
    margin: 0 0 0.6rem;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 7vw, 3.6rem);
    line-height: 1.02;
    margin: 0 0 0.75rem;
  }
  .lede {
    font-family: var(--font-body);
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 40em;
  }
  /* The one thing most visitors came to do is look a tool up, so the lookup
     is the hero's main control rather than a "Browse" button. Plain GET
     form: works without JavaScript, /tools/ reads ?q= on load. */
  .find { margin-top: 1.4rem; max-width: 34rem; }
  .find label {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .find-row { display: flex; gap: 0; }
  .find input {
    flex: 1 1 auto;
    min-width: 0;
    font: inherit;
    font-family: var(--font-mono);
    font-size: 1rem;
    padding: 0.7rem 0.8rem;
    border: 3px solid var(--line);
    border-right: none;
    border-radius: 0;
    background: var(--bg);
    color: var(--fg);
  }
  .find button {
    flex: 0 0 auto;
    font: inherit;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.7rem 1.1rem;
    background: var(--fg);
    color: var(--bg);
    border: 3px solid var(--fg);
    border-radius: 0;
    cursor: pointer;
  }
  .find button:hover { background: var(--bg); color: var(--fg); border-color: var(--line); }
  .alt { margin: 0.8rem 0 0; font-size: 0.92rem; }
  .picks { list-style: none; display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0.8rem 0 0; padding: 0; }
  .picks a {
    display: inline-block; padding: 0.3rem 0.65rem; border: 2px solid var(--line);
    font-family: var(--font-head); font-weight: 700; font-size: 0.9rem; letter-spacing: 0.04em;
    text-decoration: none; color: var(--fg);
  }
  .picks a:hover { background: var(--fg); color: var(--bg); }
  .sample { border: 3px solid var(--line); padding: 0.9rem 1rem; margin-top: 1.4rem; max-width: 34rem; }
  .s-k, .s-why-k {
    margin: 0 0 0.5rem; font-family: var(--font-head); font-size: 0.8rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
  }
  .s-m { margin: 0.6rem 0; font-size: 0.95rem; }
  .s-why-k { margin: 0.6rem 0 0.2rem; }
  .s-why {
    margin: 0 0 0.6rem; font-size: 0.9rem; color: var(--muted);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  @media (min-width: 960px) {
    .hero { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 2rem; align-items: start; }
    .sample { margin-top: 3.2rem; }
  }

  /* ---- verdict register: doubles as the legend for the badge vocabulary ---- */
  .register { margin: 1.5rem 0 2rem; }
  .register h2 { margin: 0; font-size: 1.6rem; }
  .reg-def { margin: 0.3rem 0 0.9rem; color: var(--muted); font-size: 0.92rem; max-width: 62ch; }
  .register ul { list-style: none; margin: 0; padding: 0; border-top: 3px solid var(--line); border-bottom: 3px solid var(--line); }
  .reg-row { border-bottom: 1px solid var(--line-soft); }
  .reg-row.group-start { border-top: 2px solid var(--line); }
  .row-link { color: inherit; text-decoration: none; }
  .row-link:hover .go { text-decoration: underline; }
  .row-link {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.2rem 0.9rem;
    align-items: start;
    padding: 0.75rem 0.25rem;
  }
  .reg-row:last-child { border-bottom: none; }
  .row-link .n {
    grid-row: 1 / span 3;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    font-size: 1.7rem;
    line-height: 1.1;
    text-align: right;
  }
  .row-link .m { color: var(--muted); font-size: 0.92rem; }
  .row-link .go { font-size: 0.88rem; color: var(--id); display: none; }
  @media (min-width: 760px) {
    .row-link { grid-template-columns: 2.6rem 15rem 1fr auto; align-items: center; }
    .row-link .n { grid-row: auto; }
    .row-link .go { display: inline; }
  }

  .biz { border: 2px solid var(--line-soft); padding: 1rem 1.1rem; margin: 0 0 2rem; }
  .biz h2 { margin: 0; font-size: 1.3rem; }
  .biz-def { margin: 0.3rem 0 0.8rem; color: var(--muted); font-size: 0.92rem; max-width: 62ch; }
  .biz ul { list-style: none; margin: 0 0 0.9rem; padding: 0; }
  .biz li { padding: 0.45rem 0; border-bottom: 1px solid var(--line-soft); }
  .biz li:last-child { border-bottom: none; }
  .biz .p { font-family: var(--font-mono); margin-left: 0.4rem; }
  .biz .d { display: block; color: var(--muted); font-size: 0.9rem; }
  .biz-go { margin: 0; }
  .biz .btn { display: inline-block; padding: 0.45rem 0.8rem; border: 2px solid var(--line); color: var(--fg); text-decoration: none; font-weight: 700; margin-right: 0.5rem; }
  .biz .btn:hover { background: var(--fg); color: var(--bg); }
  .biz-by { margin: 0.6rem 0 0; font-size: 0.8rem; color: var(--muted); }

  .how ol { padding-left: 1.25rem; font-family: var(--font-body); max-width: 62ch; }
  .how li { margin-bottom: 0.4rem; }
</style>
