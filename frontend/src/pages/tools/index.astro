---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/Badge.astro";
import type { Tool } from "../../types";
import toolsData from "../../../data/tools.json";

const tools = (toolsData as Tool[]).slice().sort((a, b) => a.name.localeCompare(b.name));
---
<Layout
  title="Tools"
  description="Every tool PolicyPeek has checked, with a compliant / not compliant / unrated badge and the one-line reason behind it."
>
  <h1>Tools</h1>

  {tools.length === 0 && (
    <p class="empty">
      Nothing published yet — checks are reviewed by a human before they show up here.
      See <a href="/about">how ratings get made</a>.
    </p>
  )}

  <ul class="tool-list">
    {tools.map((tool) => (
      <li class="tool-card">
        <a href={`/tools/${tool.domain}`}>
          <div class="tool-card-head">
            <span class="tool-name">{tool.name}</span>
            <Badge status={tool.compliance_status} />
          </div>
          {tool.shared_domain ? (
            <p class="reason shared-domain-note">
              Policy text is shared across multiple company products, so this badge doesn't reflect {tool.name}-specific data handling.
            </p>
          ) : (
            tool.summary && <p class="reason">{tool.summary}</p>
          )}
        </a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .empty { color: var(--muted); }
  .tool-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }
  .tool-card a {
    display: block;
    background: var(--bg);
    padding: 1rem 1.1rem;
    text-decoration: none;
    color: var(--fg);
    height: 100%;
  }
  .tool-card a:hover { background: var(--panel); }
  .tool-card-head {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 0.6rem;
    margin-bottom: 0.5rem;
  }
  .tool-name { font-family: var(--font-head); font-weight: 700; }
  .reason {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 0.88rem;
  }
  .reason.shared-domain-note {
    color: var(--amber-fg);
  }
</style>
