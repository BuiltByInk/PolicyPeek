---
import Layout from "../../layouts/Layout.astro";
import Badge from "../../components/Badge.astro";
import type { Tool } from "../../types";
import { VERDICTS, reasonFor, safeHttpUrl } from "../../verdicts";
import toolsData from "../../../data/tools.json";
import { guidesForDomain } from "../../guides";
import { gumroadLink } from "../../gumroad";

export async function getStaticPaths() {
  const tools = toolsData as Tool[];
  return tools.map((tool) => ({
    params: { domain: tool.domain },
    props: { tool },
  }));
}

const { tool } = Astro.props as { tool: Tool };
// Verdict block style hook. Each verdict has its own form as well as its own
// colour (double rule for caveats, hatched sticker for unrated, dashed for
// company-wide, plain for the rest) and always carries its text label, so
// nothing depends on colour or pattern alone.
const vclass: Record<Tool["compliance_status"], string> = {
  compliant: "green",
  compliant_with_caveats: "caveat",
  not_compliant: "red",
  unrated: "amber",
  shared_domain_unverified: "shared",
  not_ai_tool: "gray",
};
const v = vclass[tool.compliance_status];

// One-line reason next to the verdict. Amber/red never render blank (see
// reasonFor in verdicts.ts): before this, an unrated tool with an empty
// summary (Zoom AI Companion) showed a badge and no reason at all.
const reason = reasonFor(tool);
const meaning = VERDICTS.find((v) => v.status === tool.compliance_status)?.meaning ?? "";
const isNotAi = tool.compliance_status === "not_ai_tool";
// The "what this means" line only adds something when the reason above it is
// the tool's own policy wording; for fixed fallback reasons it would repeat them.
// Unrated already says "We don't know." in its own block.
const showMeaning = !isNotAi && tool.compliance_status !== "unrated" && Boolean(tool.summary && tool.summary.trim());
const verdictLabel = VERDICTS.find((x) => x.status === tool.compliance_status)?.label ?? tool.compliance_status;

// A non-AI site has nothing to say about "training on your data", so the
// fact rows say "Not applicable" rather than "Unclear from policy" (which
// reads as if the policy were vague, not as if the question doesn't apply).
const yesNo = (v: boolean | null) => (isNotAi && v === null ? "Not applicable" : v === null ? "Unclear from policy" : v ? "Yes" : "No");
const retention = tool.data_retention && tool.data_retention.trim() ? tool.data_retention : "Not stated";
// Short values keep the mono treatment (they read like label numerals);
// sentences read better in the body face than in bold monospace.
const retentionIsLong = retention.length > 48;
// "Last checked" = the last time the policy page was read and the result
// confirmed or accepted. Shown as a plain UTC date; missing for data generated
// before the column existed.
const lastCheckedDate = tool.last_checked_at ? new Date(tool.last_checked_at) : null;
const lastCheckedValid = lastCheckedDate !== null && !Number.isNaN(lastCheckedDate.getTime());
const lastCheckedText = lastCheckedValid
  ? lastCheckedDate!.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
  : "Not recorded yet";

// Audit P5: one plain human answer under the H1, built from the stored
// "trains on user data" fact plus the verdict. Wording stays descriptive of
// the published policy (see deliverables/badge-wording.md).
const plainAnswer: string | null = (() => {
  switch (tool.compliance_status) {
    case "compliant":
      return `No. ${tool.name}'s published policy says it doesn't train on your data by default.`;
    case "compliant_with_caveats":
      return `Yes, by default. ${tool.name}'s published policy says it may train on your data, but you can opt out.`;
    case "not_compliant":
      return `Yes. ${tool.name}'s published policy says it may train on your data, and we found no way to opt out.`;
    case "unrated":
      return `We can't tell. ${tool.name}'s published policy doesn't clearly say.`;
    case "shared_domain_unverified":
      return `We can't say yet. The only policy we found covers the whole company, not ${tool.name} itself.`;
    default:
      return null;
  }
})();

const sources = tool.source_urls
  .map((raw) => ({ raw, href: safeHttpUrl(raw) }));

// Title/description: title is awkward for a non-AI site ("Does hancocyber.com
// Train on Your Data?"), so it gets its own wording.
// SEO (2026-10-23): the searched question ("Does X train on my data?") plus the
// "AI training & GDPR" topic. The description states only what the verdict
// says, in Design's badge wording (verdicts.ts), never "Compliant".
const pageTitle = isNotAi
  ? `${tool.name}: not an AI tool`
  : `Does ${tool.name} train on my data? AI training & GDPR`;
// Meta description (SEO pass, 2026-09-18): a fixed template -- the question
// people search, then the verdict in plain words -- rather than the raw
// policy quote in tool.summary, which got cut off mid-sentence in results and
// was sometimes unrelated to the question (hancocyber.com's was a cookie
// line). The summary itself still shows on the page, next to the badge. The
// sourcing tail is dropped when it would push the line past ~160 characters,
// where search engines start truncating.
const verdictInfo = VERDICTS.find((v) => v.status === tool.compliance_status);
const templated = `Does ${tool.name} train on my data? ${verdictInfo ? `${verdictInfo.short}: ${verdictInfo.meaning}` : "See PolicyPeek's sourced rating."}`;
const sourcingTail = " Sourced from its own privacy policy.";
const pageDescription = isNotAi
  ? `PolicyPeek's data-training check doesn't apply to ${tool.name}: the policy we found shows no sign it's an AI product.`
  : templated.length + sourcingTail.length <= 160 ? templated + sourcingTail : templated;

const siteUrl = Astro.site!.href;

// Related tools (crawlable links): same verdict first, then others, never this
// tool and never not-an-AI-tool pages (they're noindex).
const allTools = toolsData as Tool[];
const byName = (a: Tool, b: Tool) => a.name.localeCompare(b.name);
const others = allTools.filter((t) => t.domain !== tool.domain && t.compliance_status !== "not_ai_tool");
const related = [
  ...others.filter((t) => t.compliance_status === tool.compliance_status).sort(byName),
  ...others.filter((t) => t.compliance_status !== tool.compliance_status).sort(byName),
].slice(0, 6);
const guides = guidesForDomain(tool.domain);
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "PolicyPeek", item: siteUrl },
    { "@type": "ListItem", position: 2, name: "Tools", item: `${siteUrl}tools/` },
    { "@type": "ListItem", position: 3, name: tool.name, item: `${siteUrl}tools/${tool.domain}/` },
  ],
};
const toolUrl = `${siteUrl}tools/${tool.domain}/`;
const jsonLd = [
  breadcrumbs,
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: pageTitle,
    description: pageDescription,
    url: toolUrl,
    inLanguage: "en-GB",
    ...(lastCheckedValid ? { dateModified: lastCheckedDate!.toISOString() } : {}),
    publisher: { "@type": "Organization", name: "PolicyPeek", url: siteUrl },
    about: { "@type": "SoftwareApplication", name: tool.name, url: `https://${tool.domain}/`, applicationCategory: "BusinessApplication" },
  },
  ...(!isNotAi && plainAnswer
    ? [{
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: [{ "@type": "Question", name: `Does ${tool.name} train on my data?`, acceptedAnswer: { "@type": "Answer", text: `${plainAnswer}${sourcingTail}` } }],
      }]
    : []),
];
---
<Layout title={pageTitle} description={pageDescription} noindex={isNotAi} jsonLd={jsonLd}>
  <a class="back" href="/tools">← All tools</a>

  <header class="detail-head">
    <h1>{tool.name}</h1>
    {tool.name.toLowerCase() !== tool.domain.toLowerCase() && <p class="domain">{tool.domain}</p>}
    {plainAnswer && <p class="answer">{plainAnswer}</p>}
  </header>

  <section class="label" aria-labelledby="lp-h">
    <div class="slab">
      <h2 class="k" id="lp-h">What the policy says</h2>
      <span class="k">Read from its own policy</span>
    </div>

    {/* The verdict is the loudest thing on the label (as Calories are on a nutrition label). */}
    <div class={`verdict v-${v}`}>
      {tool.compliance_status === "unrated" ? (
        <div class="plate">
          <p class="v-word"><span class="sr-only">Verdict: </span>{verdictLabel}</p>
          <p class="v-sub">We don't know.</p>
        </div>
      ) : (
        <>
          <p class="v-word"><span class="sr-only">Verdict: </span>{verdictLabel}</p>
          <span class="rule" aria-hidden="true"></span>
        </>
      )}
      {showMeaning && <p class="v-meaning">{meaning}</p>}
    </div>

    {reason && (
      <div class="why">
        <p class="why-k">Why</p>
        <p class="why-t">{reason}</p>
      </div>
    )}

    <dl class="facts">
      <div>
        <dt>Trains on user data</dt>
        <dd>{yesNo(tool.trains_on_user_data)}</dd>
      </div>
      <div>
        <dt>Data retention</dt>
        {retentionIsLong ? (
          <dd class="long">
            <details class="more">
              <summary>Show details</summary>
              {retention}
            </details>
          </dd>
        ) : (
          <dd>{retention}</dd>
        )}
      </div>
      <div>
        <dt>GDPR mentioned</dt>
        <dd>{yesNo(tool.gdpr_mentioned)}</dd>
      </div>
      <div>
        <dt>Last checked</dt>
        <dd>{lastCheckedValid ? <time datetime={lastCheckedDate!.toISOString().slice(0, 10)}>{lastCheckedText}</time> : lastCheckedText}</dd>
      </div>
      <div>
        <dt>Reviewed by a human</dt>
        <dd>{tool.auto_published ? "No — auto-published" : "Yes"}</dd>
      </div>
    </dl>
  </section>

  {sources.length > 0 && (
    <>
      <h2>Sources</h2>
      <ul class="sources">
        {sources.map(({ raw, href }) => (
          <li>
            {href
              ? <a href={href} rel="nofollow noopener noreferrer" target="_blank">{raw}<span class="sr-only"> (opens in a new tab)</span></a>
              : <span>{raw}</span>}
          </li>
        ))}
      </ul>
    </>
  )}

  {guides.length > 0 && (
    <section class="guides-for" aria-labelledby="guides-h">
      <h2 id="guides-h">Guides that cover {tool.name}</h2>
      <ul>
        {guides.map((g) => <li><a href={`/guides/${g.slug}/`}>Read: {g.title}</a></li>)}
      </ul>
    </section>
  )}

  {related.length > 0 && (
    <section class="related" aria-labelledby="rel-h">
      <h2 id="rel-h">Related tools</h2>
      <ul>
        {related.map((t) => (
          <li><a href={`/tools/${t.domain}/`}>Does {t.name} train on my data?</a></li>
        ))}
      </ul>
      <p><a href="/tools/">Browse all tools</a></p>
    </section>
  )}

  <aside class="pack-box compact" aria-labelledby="pack-h">
    <p><strong id="pack-h">Does your team use {tool.name} for work?</strong> The AI Policy Starter Pack gives you an editable UK AI policy, staff rules and an Article 4 checklist. £19. <a href={gumroadLink("starter", `tool-${tool.domain}`)}>Get the Starter Pack</a> · <a href={gumroadLink("checklist", `tool-${tool.domain}`)}>or the free checklist</a></p>
  </aside>

  <section class="next no-print" aria-label="What next">
    <form class="again" action="/tools/" method="get" role="search">
      <label for="again-q">Check another tool</label>
      <div class="again-row">
        <input id="again-q" name="q" type="search" placeholder="e.g. chatgpt" autocomplete="off" spellcheck="false" />
        <button type="submit">Look it up</button>
      </div>
    </form>
    <button type="button" class="share" data-share-url={`${siteUrl}tools/${tool.domain}/`} data-share-title={pageTitle}>Copy link / share this verdict</button>
    <p class="share-msg" role="status" aria-live="polite"></p>
  </section>
  <script>
    for (const btn of document.querySelectorAll<HTMLButtonElement>("button.share")) {
      const msg = btn.parentElement?.querySelector(".share-msg");
      btn.addEventListener("click", async () => {
        const url = btn.dataset.shareUrl || location.href;
        const title = btn.dataset.shareTitle || document.title;
        try {
          if (navigator.share && matchMedia("(pointer: coarse)").matches) {
            await navigator.share({ title, url });
            return;
          }
          await navigator.clipboard.writeText(url);
          if (msg) msg.textContent = "Link copied.";
        } catch (e) {
          if ((e as Error)?.name === "AbortError") return;
          if (msg) msg.textContent = `Copy this link: ${url}`;
        }
      });
    }
  </script>
</Layout>

<style>
  .related ul { list-style: none; padding: 0; margin: 0.5rem 0; }
  .related li { margin: 0.35rem 0; }
  .guides-for ul { list-style: none; padding: 0; margin: 0.5rem 0; }
  .guides-for li { margin: 0.35rem 0; }
  .back { display: inline-block; color: var(--muted); font-size: 0.9rem; padding: 0.3rem 0; }
  .detail-head { margin: 0.75rem 0 1.25rem; }
  .detail-head h1 {
    margin: 0;
    font-size: clamp(2.6rem, 8vw, 3.8rem);
    line-height: 1;
    overflow-wrap: anywhere;
  }
  .answer { margin: 0.8rem 0 0; font-size: 1.15rem; font-weight: 600; max-width: 40em; }
  .more summary { cursor: pointer; color: var(--id); font-family: var(--font-body); }
  .more[open] summary { margin-bottom: 0.4rem; }
  .next { margin: 2rem 0 0; border-top: 3px solid var(--line); padding-top: 1.2rem; max-width: 46rem; }
  .again label {
    display: block; margin-bottom: 0.35rem; font-family: var(--font-head); font-size: 0.85rem;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted);
  }
  .again-row { display: flex; max-width: 34rem; }
  .again input {
    flex: 1 1 auto; min-width: 0; font: inherit; font-family: var(--font-mono); padding: 0.6rem 0.7rem;
    border: 3px solid var(--line); border-right: none; border-radius: 0; background: var(--bg); color: var(--fg);
  }
  .again button, .share {
    font: inherit; font-family: var(--font-head); font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.05em; padding: 0.6rem 1rem; border: 3px solid var(--fg); border-radius: 0; cursor: pointer;
  }
  .again button { background: var(--fg); color: var(--bg); }
  .share { margin-top: 1rem; background: var(--bg); color: var(--fg); border-color: var(--line); }
  .share-msg { min-height: 1.2em; font-size: 0.9rem; color: var(--muted); }
  .domain { color: var(--muted); font-family: var(--font-mono); font-size: 0.9rem; margin: 0.4rem 0 0; overflow-wrap: anywhere; }

  /* ---- the label ---- */
  .label { border: 3px solid var(--line); margin: 0 0 1.5rem; max-width: 46rem; }
  .slab {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.55rem 1rem;
    border-bottom: 6px solid var(--line);
  }
  .k {
    margin: 0;
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  h2.k { color: var(--fg); }
  span.k { color: var(--muted); }

  .verdict { padding: 1rem 1rem 1.1rem; border-bottom: 3px solid var(--line); }
  .v-word {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(2.2rem, 9vw, 3.4rem);
    line-height: 0.95;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .rule { display: block; margin-top: 0.6rem; }
  .v-meaning { margin: 0.7rem 0 0; font-size: 0.95rem; max-width: 60ch; text-wrap: pretty; }

  .v-green { background: var(--green-bg); }
  .v-green .v-word { color: var(--green-fg); }
  .v-green .rule { border-top: 4px solid var(--green-fg); }

  .v-red { background: var(--red-bg); }
  .v-red .v-word { color: var(--red-fg); }
  .v-red .rule { border-top: 4px solid var(--red-fg); }

  /* Caveats keeps its own hue and its double rule ("qualified", like the
     double rule above a subtotal on a nutrition label). */
  .v-caveat { background: var(--caveat-bg); }
  .v-caveat .v-word { color: var(--caveat-fg); }
  .v-caveat .rule { height: 8px; border-top: 2px solid var(--caveat-fg); border-bottom: 2px solid var(--caveat-fg); }

  /* Company-wide: outlined, dashed, like its badge. */
  .v-shared { margin: 0.75rem; padding: 0.9rem 1rem 1rem; border: 2px dashed var(--amber-fg); border-bottom: 2px dashed var(--amber-fg); }
  .v-shared .v-word { color: var(--amber-fg); }
  .v-shared .rule { border-top: 3px dashed var(--amber-fg); }
  .v-shared .v-meaning { color: var(--fg); }

  .v-gray { background: var(--gray-bg); }
  .v-gray .v-word { color: var(--gray-fg); }
  .v-gray .rule { border-top: 2px solid var(--gray-fg); }

  /* Unrated = "we don't know". Hatching is decoration only: the words
     UNRATED and "We don't know." sit on a solid sticker (full AA contrast
     against the page background) so the text never overlaps the pattern and
     the meaning never depends on the pattern or the colour. */
  .v-amber {
    background: var(--amber-bg);
    background-image: repeating-linear-gradient(135deg, transparent 0 8px, color-mix(in srgb, var(--amber-fg) 32%, transparent) 8px 10px);
  }
  .plate {
    display: inline-block;
    max-width: 100%;
    padding: 0.6rem 0.9rem 0.7rem;
    background: var(--bg);
    border: 2px solid var(--amber-fg);
  }
  .v-amber .v-word { color: var(--amber-fg); }
  .v-sub {
    margin: 0.3rem 0 0;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--fg);
  }

  .why { padding: 0.85rem 1rem 1rem; border-bottom: 3px solid var(--line); }
  .why-k {
    margin: 0 0 0.25rem;
    font-family: var(--font-head);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .why-t { margin: 0; font-size: 1.05rem; line-height: 1.5; overflow-wrap: anywhere; max-width: 62ch; }

  .facts { margin: 0; }
  .facts div {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .facts div:last-child { border-bottom: none; }
  .facts dt {
    margin: 0;
    flex: 0 0 10.5rem;
    color: var(--muted);
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .facts dd {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-mono);
    font-weight: 600;
    text-align: left;
    overflow-wrap: anywhere;
  }
  /* Sentence-length values (retention policies run to 600+ characters) go in
     the body face at normal weight; bold monospace prose was a wall of text. */
  .facts dd.long {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.95rem;
    line-height: 1.5;
    max-width: 62ch;
  }
  @media (max-width: 480px) {
    .facts div { flex-direction: column; gap: 0.25rem; }
    .facts dt { flex-basis: auto; }
  }
  .sources { padding-left: 1.25rem; font-family: var(--font-body); }
  .sources li { margin-bottom: 0.4rem; overflow-wrap: anywhere; }

  /* Print: colour and pattern may not print, so the verdict gets a plain
     boxed treatment; the words carry the meaning. */
  @media print {
    .verdict { background: none !important; border: 3px solid #000; }
    .v-word, .v-sub { color: #000 !important; }
    .plate { border-color: #000; }
    .rule { border-color: #000 !important; }
    .label { max-width: none; }
  }
</style>
