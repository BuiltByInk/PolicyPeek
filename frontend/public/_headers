# Cloudflare Pages custom headers. Self-hosted fonts never change under the
# same filename (a new version would get a new filename), so cache them for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers for every page. Content-Security-Policy is generated at
# build time by integrations/csp.mjs (hashes of Astro's inline scripts); the
# placeholder below is replaced in dist/_headers and the build fails if it isn't.
/*
  Strict-Transport-Security: max-age=86400; includeSubDomains
  Content-Security-Policy: __CSP__
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

# Gumroad checkout overlay (/policy-pack/): let the Gumroad iframe (and the
# Stripe / Apple Pay / Google Pay frames nested in it) use the Payment Request
# API so Apple Pay and Google Pay work. Only this page; everywhere else keeps
# payment=(). The global value is detached and replaced, not comma-joined.
/policy-pack/
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://gumroad.com" "https://*.gumroad.com" "https://js.stripe.com" "https://*.stripe.com" "https://pay.google.com" "https://applepay.cdn-apple.com"), usb=(), interest-cohort=()

# RFC 9727 API catalog and OpenAPI spec
/.well-known/api-catalog
  Content-Type: application/linkset+json
  Access-Control-Allow-Origin: *
/openapi.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
/auth.md
  Content-Type: text/markdown; charset=utf-8

# RFC 8288 discovery links on the homepage (HTML and Markdown)
/
  Link: </.well-known/api-catalog>; rel="api-catalog", </openapi.json>; rel="service-desc", </developers/>; rel="service-doc", </llms.txt>; rel="describedby"
/index.md
  Link: </.well-known/api-catalog>; rel="api-catalog", </openapi.json>; rel="service-desc", </developers/>; rel="service-doc", </llms.txt>; rel="describedby"
