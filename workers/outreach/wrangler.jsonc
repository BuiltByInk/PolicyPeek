// Outreach SENDER Worker. Production crons enabled for steps (d)+(e) in DRY RUN (not yet deployed; Security review first).
// Safe defaults even if deployed: OUTREACH_MODE=dry_run, OUTREACH_ENABLED unset,
// D1 outreach_settings.paused='1', and no cron in the top-level config.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "policypeek-outreach-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": { "OUTREACH_MODE": "dry_run" },
  "d1_databases": [
    { "binding": "DB", "database_name": "policypeek-outreach-dev", "database_id": "e3325d9c-01c1-41a5-8b43-ea497644ee81", "migrations_dir": "migrations" }
  ],
  // Security step (f) + SF4: NO live EMAIL binding in dev. Only the test binding,
  // pinned to Elliot's verified destination, so dev can never reach anyone else.
  "send_email": [
    { "name": "EMAIL_TEST", "destination_address": "elliotink@pm.me", "allowed_sender_addresses": ["privacy@mail.getpolicypeek.com"] }
  ],
  // Secrets (wrangler secret put, never in this file): OUTREACH_ADMIN_TOKEN (>= 32 chars).
  "env": {
    "production": {
      "name": "policypeek-outreach",
      "workers_dev": false,
      "vars": { "OUTREACH_MODE": "dry_run" },
      "d1_databases": [
        { "binding": "DB", "database_name": "policypeek-outreach", "database_id": "1c15b227-8642-4642-9301-b1e8598a966a", "migrations_dir": "migrations" }
      ],
      // SF4: live EMAIL binding re-added for go-live (Elliot 14:02 UK, 10 Nov),
      // reviewed config change. Sender is pinned to privacy@mail.getpolicypeek.com.
      // Sending still needs OUTREACH_MODE=live + OUTREACH_ENABLED=true + D1
      // paused='0' + eligible contacts that pass the card gate and caps.
      "send_email": [
        { "name": "EMAIL", "allowed_sender_addresses": ["privacy@mail.getpolicypeek.com"] },
        { "name": "EMAIL_TEST", "destination_address": "elliotink@pm.me", "allowed_sender_addresses": ["privacy@mail.getpolicypeek.com"] }
      ],
      // Steps (d)+(e): crons on, still DRY RUN. 30 3 = purge (03:30 UTC);
      // 0 9 = daily sender run (09:00 UTC), which logs mode=dry_run and sends
      // nothing while OUTREACH_MODE=dry_run, OUTREACH_ENABLED is unset, there is
      // no live EMAIL binding and D1 paused='1'.
      "triggers": { "crons": ["0 9 * * *", "30 3 * * *"] }
    }
  }
}
