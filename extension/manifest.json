{
  "manifest_version": 3,
  "name": "PolicyPeek",
  "short_name": "PolicyPeek",
  "version": "0.1.0",
  "description": "See whether an AI or SaaS tool's published policy says it trains on your data.",

  "permissions": ["activeTab", "storage"],

  "host_permissions": [
    "https://api.getpolicypeek.com/*"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "policypeek@builtbyink.com",
      "data_collection_permissions": { "required": ["browsingActivity"] }
    }
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "PolicyPeek",
    "default_icon": {
      "16": "icons/loading-16.png",
      "32": "icons/loading-32.png",
      "48": "icons/loading-48.png",
      "128": "icons/loading-128.png"
    }
  },

  "icons": {
    "16": "icons/loading-16.png",
    "32": "icons/loading-32.png",
    "48": "icons/loading-48.png",
    "128": "icons/loading-128.png"
  }
}
